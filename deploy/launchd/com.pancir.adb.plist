<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  The farm's single adb server, owned by launchd (see deploy/adb-server-run.sh
  for why it must not be left to on-demand starts). LaunchAgent in the user's
  session, next to poligon: best USB access, and poligon may restart it
  without sudo.

  Install: scripts/install-all.sh
  Restart: launchctl kickstart -k gui/$(id -u)/com.pancir.adb
           (then ws-scrcpy: poligon's watchdog does that by itself)
-->
<plist version="1.0">
<dict>
  <key>Label</key>            <string>com.pancir.adb</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/dev-mac/poligon/deploy/adb-server-run.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>            <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>KeepAlive</key>         <true/>
  <key>RunAtLoad</key>         <true/>
  <key>ThrottleInterval</key>  <integer>5</integer>
  <key>ExitTimeOut</key>       <integer>10</integer>
  <key>ProcessType</key>       <string>Interactive</string>
  <key>StandardOutPath</key>   <string>/Users/dev-mac/poligon/adb.log</string>
  <key>StandardErrorPath</key> <string>/Users/dev-mac/poligon/adb.log</string>
</dict>
</plist>
